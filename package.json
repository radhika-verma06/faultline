{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "description": "Finds the exact misconception behind a wrong answer, and teaches only that.",
  "scripts": {
    "dev": "next dev --port 3311",
    "build": "next build",
    "start": "next start --port 3311",
    "demo": "next build && next start --port 3311",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "smoke": "node scripts/smoke.mjs",
    "smoke:install": "node scripts/install-browser.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.1"
  }
}
